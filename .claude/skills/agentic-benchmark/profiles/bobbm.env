# Profile: GKE cluster bobbm, namespace llm-d-program-aware-scheduling (steps 07 to 27).
# Sourced by scripts/lib.sh as profiles/$PROFILE.env (PROFILE=bobbm is the default).
# Every value is a default: a variable already set in the environment wins, so a
# step can still override one setting without a new profile. To benchmark another
# cluster, copy this file to profiles/<name>.env and run with PROFILE=<name>.

# --- cluster -----------------------------------------------------------------
CTX=${CTX:-gke_bobzetian-gke-dev_us-central1_bobbm}   # kube context the scripts pin to
NS=${NS:-llm-d-program-aware-scheduling}
CLIENT_NODE_LABEL=${CLIENT_NODE_LABEL:-cloud.google.com/gke-nodepool}  # nodeSelector key for client pods
CLIENT_POOL=${CLIENT_POOL:-default-pool}                                # its value (non-spot CPU nodes)
STORAGE_CLASS=${STORAGE_CLASS:-standard-rwo}                            # PVC class for the client data disk
PVC_SIZE=${PVC_SIZE:-200Gi}
MODEL_SERVER_COLLECT=${MODEL_SERVER_COLLECT:-1}   # run model-server/collect.sh into meta/ (bobbm-specific script)

# --- model server (vLLM) ------------------------------------------------------
DEPLOY=${DEPLOY:-program-aware-vllm-decode}
DECODE_SELECTOR=${DECODE_SELECTOR:-llm-d.ai/guide=program-aware-scheduling,llm-d.ai/role=decode}
VLLM_CONTAINER=${VLLM_CONTAINER:-modelserver}
VLLM_PORTS=${VLLM_PORTS:-8000}
MODEL=${MODEL:-Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8}

# --- router (EPP) -------------------------------------------------------------
EPP_DEPLOY=${EPP_DEPLOY:-program-aware-scheduling-epp}
EPP_URL=${EPP_URL:-http://program-aware-scheduling-epp:80}   # MODE=pool client URL
EPP_METRICS_PORT=${EPP_METRICS_PORT:-9090}
METRICS_READER_SA=${METRICS_READER_SA:-thunderagent-metrics-reader}   # manifests/metrics-reader-rbac.yaml
EPP_IMAGE_TAG=${EPP_IMAGE_TAG:-thunder-agent-pr3-a025437b-produces}   # render-lane-epp.sh default
EPP_CHART_DIR=${EPP_CHART_DIR:-}   # llm-d-router charts folder; empty = ../llm-d-router-thunder-lease/config/charts next to the repo

# --- client (aiperf, AgentX scenario) ------------------------------------------
IMAGE=${IMAGE:-us-central1-docker.pkg.dev/bobzetian-gke-dev/bobinference/agentx-harness:agentx-v1.0.6}
DATASET=${DATASET:-semianalysis_cc_traces_weka_062126_256k}
PVC_BASE=${PVC_BASE:-agentx-data}   # lane a uses PVC_BASE, other lanes PVC_BASE-<lane>
