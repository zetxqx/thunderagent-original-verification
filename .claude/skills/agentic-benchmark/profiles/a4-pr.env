# Profile: GKE cluster a4-pr (project supercomputer-testing, europe-west4), namespace
# bobzetian-llmd, B200 nodes (steps 25 to 28). Sourced by scripts/lib.sh with PROFILE=a4-pr.
# Every value is a default: a variable already set in the environment wins.
# The deployment defaults are the GLM-5.2-NVFP4 TP=8 server of steps 25 and 28 (glm52-tp8,
# lane a); other servers set DEPLOY, DECODE_SELECTOR, LANE (and for Qwen3.5 in step 26,
# MODEL and GPUS_PER_POD=4) per point.

# --- cluster -----------------------------------------------------------------
CTX=${CTX:-gke_supercomputer-testing_europe-west4_a4-pr}
# Written by `KUBECONFIG=/tmp/a4-pr.kubeconfig gcloud container clusters get-credentials a4-pr
# --region europe-west4 --project supercomputer-testing`, so the user's kubeconfig is untouched.
KUBECONFIG_SOURCE=${KUBECONFIG_SOURCE:-/tmp/a4-pr.kubeconfig}
NS=${NS:-bobzetian-llmd}
CLIENT_NODE_LABEL=${CLIENT_NODE_LABEL:-cloud.google.com/gke-nodepool}
CLIENT_POOL=${CLIENT_POOL:-pool-1}      # CPU pool, shared with other teams' clients and EPPs
STORAGE_CLASS=${STORAGE_CLASS:-standard-rwo}
PVC_SIZE=${PVC_SIZE:-200Gi}
MODEL_SERVER_COLLECT=${MODEL_SERVER_COLLECT:-0}   # model-server/collect.sh reads the bobbm deployment

# --- model server (vLLM) ------------------------------------------------------
DEPLOY=${DEPLOY:-glm52-tp8}
DECODE_SELECTOR=${DECODE_SELECTOR:-app=glm52-tp8}
VLLM_CONTAINER=${VLLM_CONTAINER:-modelserver}
VLLM_PORTS=${VLLM_PORTS:-8000}
MODEL=${MODEL:-nvidia/GLM-5.2-NVFP4}
GPUS_PER_POD=${GPUS_PER_POD:-8}   # GPUs come through DRA, so nvidia.com/gpu limits are empty

# --- router (EPP) -------------------------------------------------------------
# One lane EPP per server (agentx-epp-<lane>-epp), endpoints from a file: our account cannot
# create RBAC on a4-pr. Steps set EPP_DEPLOY and URL per point.
EPP_DEPLOY=${EPP_DEPLOY:-agentx-epp-a-epp}
EPP_URL=${EPP_URL:-http://agentx-epp-a-epp:80}
EPP_METRICS_PORT=${EPP_METRICS_PORT:-9090}
METRICS_READER_SA=${METRICS_READER_SA:-thunderagent-metrics-reader}
EPP_IMAGE_TAG=${EPP_IMAGE_TAG:-thunder-agent-pr3-a025437b-produces}   # step 28 renders v1.0.0 with its own chart
EPP_CHART_DIR=${EPP_CHART_DIR:-}

# --- client (aiperf, AgentX scenario) ------------------------------------------
IMAGE=${IMAGE:-us-central1-docker.pkg.dev/bobzetian-gke-dev/bobinference/agentx-harness:agentx-v1.0.6}
DATASET=${DATASET:-semianalysis_cc_traces_weka_062126}   # full traces, as in steps 25 to 28
PVC_BASE=${PVC_BASE:-agentx-data}
